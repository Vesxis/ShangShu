# 商枢｜高并发电商交易平台
# MySQL 8.0；Compose 会为后端和任务进程固定使用容器内的 db:3306。
DB_USER=shangshu
DB_PASSWORD=change-this-db-password
DB_ROOT_PASSWORD=change-this-root-password
DB_HOST=db
DB_PORT=3306
DB_NAME=shangshu

SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
DEBUG=false

REDIS_URL=redis://redis:6379
RABBITMQ_USER=shangshu
RABBITMQ_PASSWORD=change-this-broker-password
RABBITMQ_URL=amqp://shangshu:change-this-broker-password@rabbitmq:5672//

HTTP_PORT=8080
BASE_URL=http://localhost:8080/api
FRONTEND_URL=http://localhost:8080

EMAIL_USER=
EMAIL_PASSWORD=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20

